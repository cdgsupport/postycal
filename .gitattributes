# Files excluded from `git archive`, and therefore from the release zip.
# Keep this in sync with anything added to the repo that isn't shipped.
/.github        export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/.claude        export-ignore
/bin            export-ignore

# Normalise line endings for text so zips are byte-identical across platforms.
*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
